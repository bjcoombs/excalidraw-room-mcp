{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "testRunner": "command",
  "buildCommand": "npx tsc -p tsconfig.json",
  "commandRunner": { "command": "node --test dist/*.test.js" },
  "mutate": ["src/crypto.ts", "src/reconcile.ts", "src/elements.ts"],
  "reporters": ["json", "progress", "clear-text"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 60000,
  "disableTypeChecks": true
}
