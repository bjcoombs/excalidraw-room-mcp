{
  // The view is a Vite bundle for the browser and `npm test` runs Node, so the
  // view's pure modules are compiled a second time here - to CommonJS-free
  // NodeNext under dist/view-test/ - and their tests run alongside the
  // server's. A module belongs in `include` if it runs under Node: the pure
  // ones, and the React parts that renderToStaticMarkup can render without a
  // browser. Anything that touches the Excalidraw component cannot.
  // .mcpbignore and scripts/check-bundle.sh keep this output out of the bundle.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "outDir": "dist/view-test",
    "rootDir": "view/src",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "view/src/payload.ts",
    "view/src/payload.test.ts",
    "view/src/bounds.ts",
    "view/src/scene.ts",
    "view/src/scene.test.ts",
    "view/src/status.tsx",
    "view/src/status.test.tsx",
    "view/src/announce.ts",
    "view/src/announce.test.tsx",
    "view/src/menu.tsx",
    "view/src/menu.test.tsx",
    "view/src/snapshot.ts",
    "view/src/snapshot.test.ts"
  ]
}
